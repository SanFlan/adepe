{
  "name": "@adepe/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:contract": "node scripts/check-contract.mjs",
    "predev": "npm run check:contract && npm run sync:zk",
    "dev": "vite",
    "prebuild": "npm run check:contract && npm run sync:zk",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
