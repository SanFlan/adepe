# ADEPE — contract environment
#
# Copy this file per network and fill in what you need:
#
#     cp .env.example .env.preview
#
# Files named .env.* are gitignored (this template is the one exception).
# Nothing here is needed for local development: `make dev` and `make test` run
# entirely offline, and the local network uses a well-known pre-funded account.


# ---------------------------------------------------------------- the wallet
#
# Needed only to deploy, or to run the integration test against a public
# network. Pays transaction fees, and nothing else: it never sees a patient's
# record, and it is not the contract's admin.
#
# Get one:
#   1. Create a wallet and copy its seed, or generate 32 random bytes:
#        head -c 32 /dev/urandom | xxd -p -c 64
#   2. Fund it from the faucet:
#        https://midnight-tmnight-preview.nethermind.dev/
#   3. Paste the seed below. 64 hex characters, no 0x prefix.
#
# Set exactly one of SEED or MNEMONIC, not both.

# MIDNIGHT_PREVIEW_SEED=
# MIDNIGHT_PREVIEW_MNEMONIC=

# Same pattern for other networks:
# MIDNIGHT_PREPROD_SEED=


# ----------------------------------------------------------- the contract admin
#
# Whoever holds this can open trials and register issuers on the deployed
# contract, forever. It is not a wallet and holds no funds.
#
# Leave it unset for a first deploy: scripts/deploy.ts generates one, prints it
# once, and that is the only time you will see it. Save it back here afterwards
# if you want to open more trials later.
#
# Deliberately NOT the value the app hardcodes for its local modes — deploying
# with that one would make every reader of the shipped JavaScript an admin.

# ADEPE_ADMIN_SECRET=


# ------------------------------------------------------------------- optional

# Where to prove. Defaults to a local proof server on 6300, which is what
# `make proof-server` starts.
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# How long to wait for the wallet to sync before giving up. Public networks can
# take a while on a first run.
# MIDNIGHT_SYNC_TIMEOUT_MS=3600000

# Read a different deployment than the one in deployment.<network>.json.
# ADEPE_CONTRACT_ADDRESS=

# pino log level: trace | debug | info | warn | error
# LOG_LEVEL=info


# ----------------------------------------------------------------- the issuer
#
# The clinic's signing key lives in the app, not here — see app/.env.example.
# It is the key the contract trusts, so `scripts/deploy.ts` registers whichever
# one the app is built with. Change it and you must deploy again.
